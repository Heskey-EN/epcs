# Copy to .env for local development, or set these in Vercel →
# Settings → Environment Variables. Nothing here is a real value.
#
# .env is gitignored. Never commit a secret key: if one is ever pasted into a
# file that is tracked, rotate it in Stripe rather than deleting the commit.

# ── This deployment's own address ──────────────────────────────────────────
# Set once a real domain points here. Without it the build falls back to
# VERCEL_PROJECT_PRODUCTION_URL, which Vercel provides automatically.
# Drives: canonical tags, JSON-LD @ids, the sitemap, and Stripe's return URLs.
SITE_URL=https://example.com
# The same value, read by the serverless functions (they do not see SITE_URL's
# build-time injection). Set both to the same thing.
PUBLIC_SITE_URL=https://example.com

# ── Search engines ─────────────────────────────────────────────────────────
# Default (unset) is NOINDEX: robots.txt says Disallow: /, every page carries
# <meta name="robots" content="noindex, nofollow">, and no sitemap is written.
# That is deliberate — see src/data/site.js. Set to true ONLY if this domain
# becomes the primary home for the booking page.
# INDEXABLE=true

# ── Stripe ─────────────────────────────────────────────────────────────────
# Server-only. sk_test_… while testing, sk_live_… in production.
# If this is missing or expired the order form tells the customer to phone
# instead of showing "try again" — see api/checkout.js.
# Format: "sk_test_" (or "sk_live_") followed by the key Stripe gives you.
STRIPE_SECRET_KEY=

# ── EmailJS (the booking notification sent from /booked) ───────────────────
# These are public by design: EmailJS keys are meant to be used from a browser.
VITE_EMAILJS_SERVICE=service_xxxxxxx
VITE_EMAILJS_TEMPLATE=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx
