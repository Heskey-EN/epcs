# Copy to .env for local development, or set these in Vercel →
# Settings → Environment Variables. Nothing here is a real value.
#
# .env is gitignored. Never commit a secret key: if one is ever pasted into a
# file that is tracked, rotate it in Stripe rather than deleting the commit.

# ── This deployment's own address ──────────────────────────────────────────
# Set once a real domain points here. Without it the build falls back to
# VERCEL_PROJECT_PRODUCTION_URL, which Vercel provides automatically.
# Drives: canonical tags, JSON-LD @ids, the sitemap, and Stripe's return URLs.
SITE_URL=https://example.com
# The same value, read by the serverless functions (they do not see SITE_URL's
# build-time injection). Set both to the same thing.
PUBLIC_SITE_URL=https://example.com

# ── Search engines ─────────────────────────────────────────────────────────
# Default (unset) is NOINDEX: robots.txt says Disallow: /, every page carries
# <meta name="robots" content="noindex, nofollow">, and no sitemap is written.
# That is deliberate — see src/data/site.js. Set to true ONLY if this domain
# becomes the primary home for the booking page.
# INDEXABLE=true

# ── Stripe ─────────────────────────────────────────────────────────────────
# Server-only. sk_test_… while testing, sk_live_… in production.
# If this is missing or expired the order form tells the customer to phone
# instead of showing "try again" — see api/checkout.js.
# Format: "sk_test_" (or "sk_live_") followed by the key Stripe gives you.
STRIPE_SECRET_KEY=

# ── Stripe webhook ─────────────────────────────────────────────────────────
# Stripe → /api/stripe-webhook, on checkout.session.completed. This is what
# makes the booking email guaranteed: it fires from Stripe's servers whatever
# the customer's browser does. Create the endpoint in the Stripe dashboard and
# paste its signing secret here. Without it the webhook refuses every request.
STRIPE_WEBHOOK_SECRET=

# ── Resend (the booking notification emails) ───────────────────────────────
# Server-only — never prefix this VITE_, that would publish it to the browser.
RESEND_API_KEY=

# Where the notifications go. Defaults to COMPANY.email if unset.
BOOKINGS_EMAIL=

# The From: address. Leave blank to use Resend's shared sending domain, which
# needs no DNS setup and is fine for mail to yourself. To send from your own
# domain — necessary before you ever email a CUSTOMER — verify fastepcs.com in
# Resend, add the DNS records it gives you, then set this to something like
# "Eco Futures Bookings <bookings@fastepcs.com>".
BOOKINGS_FROM=

# ── £1 notification test (leave OFF) ───────────────────────────────────────
# Stripe will not deliver a fake event to a LIVE webhook endpoint, so the only
# way to prove the booking email really arrives is a real payment. Setting this
# to exactly 'true' adds a £1 'test' product to api/checkout.js that nothing on
# the site links to. Run the test, refund the £1, then set it back to blank and
# redeploy. Do not leave it on.
TEST_CHECKOUT_ENABLED=
